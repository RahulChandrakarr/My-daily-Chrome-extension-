{
  "manifest_version": 3,
  "name": "My Daily",
  "version": "1.0.0",
  "description": "A new tab dashboard with your to-do list, AI news and a daily learning brief.",
  "chrome_url_overrides": {
    "newtab": "dashboard.html"
  },
  "action": {
    "default_title": "Open My Daily",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "search", "alarms", "notifications"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
